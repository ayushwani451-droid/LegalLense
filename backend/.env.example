# Copy to .env for local overrides, or set these directly in your
# Render/Railway service's environment variables for production.
# None of these are secrets - there are no API keys in this backend yet.

# Comma-separated list of exact frontend origins allowed to call this API.
# Required in production - set to your real Vercel deployment URL(s).
# Local development already works without setting this at all (see
# main.py: any localhost/127.0.0.1 origin is allowed unconditionally,
# regardless of this variable).
#
#   LOCAL (optional, already covered by the unconditional regex above):
#     CORS_ALLOWED_ORIGINS=http://localhost:8899
#
#   RAILWAY (required before going live - do not guess/invent the real
#   domain, set this to whatever the actual deployed Vercel URL is):
#     CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# Must match (or exceed) whatever the frontend's upload UI advertises.
MAX_UPLOAD_MB=15

# Leave unset/false unless you've verified MKL-DNN does not crash PaddleOCR
# on your specific deployment host (it does on the Windows CPU this project
# was developed on - see backend/ocr/README.md).
OCR_ENABLE_MKLDNN=false

# Set automatically by most hosts (Render, Railway); the start command
# should read it as `--port $PORT` rather than hardcoding a port number.
# PORT=8000
