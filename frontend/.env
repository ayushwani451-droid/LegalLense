# Loaded by Vite in every mode (dev, build, preview) as the baseline
# default. Safe to commit: it's just the public backend URL, not a secret.
#
# Currently pointed at the deployed Render backend for this Vercel
# deployment. If you go back to local-only development, change this back
# to VITE_API_BASE_URL=http://localhost:8000 - do not keep two
# VITE_API_BASE_URL lines in this file; only the last one Vite parses
# takes effect, which is confusing and easy to lose track of.
VITE_API_BASE_URL=https://legallense-backend.onrender.com
