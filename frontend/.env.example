# Copy relevant lines into the real env file for your environment.
# Only genuinely public configuration belongs here - VITE_ variables are
# bundled into the client-side build and are visible to anyone using the
# site. Never put API keys or secrets behind a VITE_ prefix.

# Local development / build default (already set in the committed .env
# file, since it holds no secret - just the local backend URL):
VITE_API_BASE_URL=http://localhost:8000

# Production: do NOT commit a .env.production file with a guessed domain.
# Instead, set VITE_API_BASE_URL in the Vercel Project Settings ->
# Environment Variables (scoped to "Production"), pointing at wherever the
# FastAPI backend is actually deployed, e.g.:
# VITE_API_BASE_URL=https://legallense-backend.onrender.com
